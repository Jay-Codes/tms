# Copy to .env (gitignored). Dev defaults match docker-compose.yml fallbacks.

POSTGRES_USER=tms
POSTGRES_PASSWORD=tms_dev
POSTGRES_DB=tms
DATABASE_URL=postgres://tms:tms_dev@localhost:5432/tms?sslmode=disable

REDIS_URL=redis://localhost:6379/0

