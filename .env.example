# Copy to .env (gitignored). Dev defaults match docker-compose.yml fallbacks.

ENV=dev
API_PORT=8081

# Public origin the apps are served from. In dev set this to the ngrok URL.
APP_BASE_URL=https://ce18-102-64-69-147.ngrok-free.app
# Origin used to build public links (QR targets, verification). Defaults to APP_BASE_URL.
PUBLIC_BASE_URL=

# Opaque session lifetime (30 days)
SESSION_TTL_HOURS=720

POSTGRES_USER=tms
POSTGRES_PASSWORD=tms_dev
POSTGRES_DB=tms
DATABASE_URL=postgres://tms:tms_dev@localhost:5433/tms?sslmode=disable

REDIS_URL=redis://localhost:6379/0

# Comma-separated CIDRs whose requests may set X-Forwarded-For / X-Real-IP on a
# caller's behalf. Anything outside this set has those headers ignored, so audit
# IPs and rate-limit buckets cannot be spoofed. Default: loopback (the dev Go
# proxy on :8080 is the only hop in front of the API).
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128


MINIO_ROOT_USER=tms
MINIO_ROOT_PASSWORD=tms_dev_secret
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
# Origin presigned MinIO URLs are signed against. The Go dev proxy forwards
# /branding, /qrcodes, /kyc, /signatures to MinIO :9000 without rewriting Host,
# so links work from phones. Defaults to APP_BASE_URL; http://localhost:9000
# when both are unset.
MINIO_PUBLIC_URL=http://localhost:8080

# Beem SMS (Phase 6; dev mode logs SMS instead of sending)
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=
# Size of the SMS sending pool (Phase 6). Three workers drain the Redis queue
# in parallel; each claims its row atomically, so raising this cannot duplicate
# a message.
NOTIFY_WORKERS=3

# pgcrypto symmetric key for renter_profiles.nida_number (SPEC §8).
# Rotate for anything but local dev — changing it makes existing values unreadable.
NIDA_ENC_KEY=dev-nida-key-change-me

# First platform admin, seeded on startup when no platform_admin exists yet.
ADMIN_EMAIL=admin@tms.local
ADMIN_PASSWORD=admin12345
