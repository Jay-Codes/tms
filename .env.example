# Copy to .env (gitignored). Dev defaults match docker-compose.yml fallbacks.

ENV=dev
API_PORT=8081

# Public origin the apps are served from. In dev set this to the ngrok URL.
APP_BASE_URL=https://ce18-102-64-69-147.ngrok-free.app
# Origin used to build public links (QR targets, verification). Defaults to APP_BASE_URL.
PUBLIC_BASE_URL=

# Opaque session lifetime (30 days)
SESSION_TTL_HOURS=720

POSTGRES_USER=tms
POSTGRES_PASSWORD=tms_dev
POSTGRES_DB=tms
DATABASE_URL=postgres://tms:tms_dev@localhost:5433/tms?sslmode=disable

REDIS_URL=redis://localhost:6379/0

MINIO_ROOT_USER=tms
MINIO_ROOT_PASSWORD=tms_dev_secret
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false

# Beem SMS (Phase 6; dev mode logs SMS instead of sending)
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=
