# Copy to .env (gitignored). Dev defaults match docker-compose.yml fallbacks.

ENV=dev
API_PORT=8081

# Public origin the apps are served from. In dev set this to the ngrok URL.
APP_BASE_URL=https://ce18-102-64-69-147.ngrok-free.app
# Origin used to build public links (QR targets, verification). Defaults to APP_BASE_URL.
PUBLIC_BASE_URL=
# Where the renter and landlord apps live, basePath included. Empty in dev:
# derived as {PUBLIC_BASE_URL or APP_BASE_URL}/enduser and /tenant (the proxy
# layout). Set explicitly when the apps are on their own domains (see
# .env.deploy.example).
ENDUSER_BASE_URL=
TENANT_BASE_URL=

# Cross-origin apps. Empty in dev (same origin behind the proxy: no CORS, Lax
# cookies). For apps on other origins: comma-separated allowlist, then
# COOKIE_SAME_SITE=none and COOKIE_SECURE=1 (browsers require Secure with None).
CORS_ALLOWED_ORIGINS=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=

# Opaque session lifetime (30 days)
SESSION_TTL_HOURS=720

POSTGRES_USER=tms
POSTGRES_PASSWORD=tms_dev
POSTGRES_DB=tms
DATABASE_URL=postgres://tms:tms_dev@localhost:5433/tms?sslmode=disable
# Maximum pgx pool connections. Every in-flight request holds one for the
# length of its queries, so this caps concurrent database work — size it
# against Postgres max_connections (docs/LOADTEST.md).
DB_MAX_CONNS=20

REDIS_URL=redis://localhost:6379/0

# Comma-separated CIDRs whose requests may set X-Forwarded-For / X-Real-IP on a
# caller's behalf. Anything outside this set has those headers ignored, so audit
# IPs and rate-limit buckets cannot be spoofed. Default: loopback (the dev Go
# proxy on :8080 is the only hop in front of the API).
TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128


MINIO_ROOT_USER=tms
MINIO_ROOT_PASSWORD=tms_dev_secret
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
# Origin presigned MinIO URLs are signed against. The Go dev proxy forwards
# /branding, /qrcodes, /kyc, /signatures, /receipts to MinIO :9000 without rewriting Host,
# so links work from phones. Defaults to APP_BASE_URL; http://localhost:9000
# when both are unset.
MINIO_PUBLIC_URL=http://localhost:8080

# Beem SMS (Phase 6; dev mode logs SMS instead of sending)
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=
# Size of the SMS sending pool (Phase 6). Three workers drain the Redis queue
# in parallel; each claims its row atomically, so raising this cannot duplicate
# a message.
NOTIFY_WORKERS=3

# pgcrypto symmetric key for renter_profiles.nida_number (SPEC §8).
# Rotate for anything but local dev — changing it makes existing values unreadable.
NIDA_ENC_KEY=dev-nida-key-change-me

# First platform admin, seeded on startup when no platform_admin exists yet.
ADMIN_EMAIL=admin@tms.local
ADMIN_PASSWORD=admin12345

# --- deployment: full compose profile (`make deploy`) ---
# These are read only by the `full` profile in docker-compose.yml; the dev loop
# ignores them. Inside the compose network the API reaches postgres:5432,
# redis:6379 and minio:9000, so DATABASE_URL/REDIS_URL/MINIO_ENDPOINT above are
# overridden per-service and do not need changing here.

# Public origin the deployed stack is served from. APP_BASE_URL,
# PUBLIC_BASE_URL and MINIO_PUBLIC_URL for the deployed API are all derived
# from this, so presigned URLs and QR targets point at something reachable.
# Set PUBLIC_BASE_URL above, or pass it inline for a one-off deploy:
#   PUBLIC_BASE_URL=http://localhost:8090 PROXY_HTTP_PORT=8090 make deploy

# Host ports the proxy container publishes. Defaults 80/443; override to run a
# deploy next to a dev preview that already owns :8080.
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# CIDRs the deployed API trusts for X-Forwarded-For (the proxy container's IP
# comes from the compose bridge network, so it is not a fixed address).
TRUSTED_PROXY_CIDRS_FULL=172.16.0.0/12,10.0.0.0/8,127.0.0.0/8

# TLS at the proxy. Set BOTH to serve 443 and redirect 80 -> 443; leave unset
# for plain HTTP. Paths are inside the proxy container: `make tls-selfsigned`
# writes a pair into .dev/tls, which is mounted at /etc/tms/tls.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Notification kinds that never consume SMS credits (comma list; "none" = charge for everything)
SMS_CREDIT_EXEMPT_KINDS=otp
