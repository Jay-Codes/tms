# Tenant app (landlord org staff; desktop dashboard). Copy to .env.local (gitignored) for local
# overrides; on Vercel set these in Project → Settings → Environment Variables.
#
# The app holds no secrets and no business logic: it is a CSR client of the Go
# API. Nothing here is required in dev — `make preview` serves it at
# http://localhost:8080/tenant behind the Go proxy, which also routes /api.
# Production: https://lms.kuzo.co.tz

# --- deploy (Vercel) ----------------------------------------------------
# Origin of the Go API. Build-time (NEXT_PUBLIC_*). Empty = same origin (dev).
# Cross-origin calls need this app's origin in the API's CORS_ALLOWED_ORIGINS
# and COOKIE_SAME_SITE=none there; presigned MinIO uploads go to the same
# host (MINIO_PUBLIC_URL), which the edge proxy forwards.
NEXT_PUBLIC_API_URL=https://api.tms.kuzo.co.tz

# Path the app is mounted under. Unset = '/tenant' (dev, one origin for all three
# apps). On its own domain leave it EMPTY so the app serves from /. Read by
# next.config.js (basePath) and lib/basePath.ts (manifest, icons, service
# worker scope).
NEXT_PUBLIC_BASE_PATH=

# Invite and verify links (/invite?token=, /verify?token=) are built from the
# server's TENANT_BASE_URL — set that to this app's public origin in
# .env.deploy.

# --- service worker -----------------------------------------------------
# The PWA service worker registers in production builds only. Set to 1 to
# register it in `next dev` too (normally off: it caches HMR chunks).
NEXT_PUBLIC_ENABLE_SW=

# --- build --------------------------------------------------------------
# Output dir for `next build`. `make build` sets .next-build so a production
# build never clobbers the running dev server's .next. Leave unset on Vercel.
#NEXT_DIST_DIR=
