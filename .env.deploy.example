# Server deploy config — copy to .env.deploy (gitignored). Read by
# docker-compose.deploy.yml for interpolation AND passed verbatim to the API
# container. Frontends are on Vercel; only the Go API + edge proxy run here.
#
#   make docker-deploy            # reuse existing postgres/redis/minio on the box
#   make docker-deploy INFRA=own  # run our own postgres/redis/minio too

# --- runtime ------------------------------------------------------------
# NOTE: ENV=prod currently refuses to boot: there is no production email
# provider yet (notify.EmailProviderFor). Keep ENV=dev until one exists;
# SMS still goes through Beem as soon as BEEM_API_KEY is set.
ENV=dev
# Set NAME to keep several TMS stacks apart on one host (containers, volumes).
COMPOSE_PROJECT_NAME=tms

# --- public origins -----------------------------------------------------
# Four hosts: the API here, the three apps on Vercel.
#   api.tms.kuzo.co.tz    Go API + MinIO bucket prefixes (this stack)
#   tms.kuzo.co.tz        renter app       (apps/enduser)
#   lms.kuzo.co.tz        landlord app     (apps/tenant)
#   tms-admin.kuzo.co.tz  platform admin   (apps/admin)
# Links the API builds are based on the app URLs (no basePath on Vercel):
# {ENDUSER_BASE_URL}/u/{code}, /contract/{id}, /payments;
# {TENANT_BASE_URL}/invite?token=, /verify?token=.
ENDUSER_BASE_URL=https://tms.kuzo.co.tz
TENANT_BASE_URL=https://lms.kuzo.co.tz
# Legacy single-origin fallback (dev proxy layout, "{APP_BASE_URL}/enduser").
# Only consulted when the two above are empty.
APP_BASE_URL=https://tms.kuzo.co.tz
PUBLIC_BASE_URL=
# Origin presigned MinIO URLs are signed against: the API host. The edge
# proxy forwards /branding, /qrcodes, /kyc, /signatures, /receipts, /proofs
# to MinIO with Host unchanged. `make server-setup` fronts it with TLS.
MINIO_PUBLIC_URL=https://api.tms.kuzo.co.tz

# --- cross-origin apps --------------------------------------------------
# Browser calls come from the three app origins, so the API must allow them
# (exact match, comma-separated, no trailing slash) and the session cookies
# must be SameSite=None + Secure or the browser drops them on fetch().
CORS_ALLOWED_ORIGINS=https://tms.kuzo.co.tz,https://lms.kuzo.co.tz,https://tms-admin.kuzo.co.tz
COOKIE_SAME_SITE=none
# Secure is automatic under ENV=prod; needed explicitly while ENV=dev.
COOKIE_SECURE=1

# --- edge proxy ---------------------------------------------------------
# Loopback bind for the host reverse proxy (Caddy/nginx on 80/443). Pick a
# port no other stack uses (in use on the box: 3100, 3101, 3200, 5433, 8181).
TMS_EDGE_BIND=127.0.0.1
TMS_EDGE_PORT=3300

# --- infra: reuse vs own ------------------------------------------------
# Docker network the API/edge join. Reuse mode: the other project's network
# (`docker network ls`, e.g. kyohuo_default) so `postgres`, `redis`, `minio`
# resolve by service name. Own mode: leave as tms-infra (make creates it).
INFRA_NETWORK=tms-infra

# Reuse mode — an existing Postgres. Create a dedicated role + database first:
#   docker exec -it <pg-container> psql -U <superuser> -c "CREATE USER tms WITH PASSWORD '...';"
#   docker exec -it <pg-container> psql -U <superuser> -c "CREATE DATABASE tms OWNER tms;"
# Own mode — POSTGRES_* below are used to create the container; DATABASE_URL
# must match them (host `postgres`).
POSTGRES_USER=tms
POSTGRES_PASSWORD=change-me
POSTGRES_DB=tms
DATABASE_URL=postgres://tms:change-me@postgres:5432/tms?sslmode=disable
DB_MAX_CONNS=20

# Reuse mode: pick a redis DB index nobody else uses (/1, /2, ...).
REDIS_URL=redis://redis:6379/1

# MinIO. Reuse mode: MINIO_ROOT_USER/PASSWORD are the *access/secret key* the
# API uses (a service account on the shared server with bucket-create rights,
# made with `mc admin user add`), not that server's root credentials.
# Bucket names are fixed (branding, qrcodes, kyc, signatures, receipts, proofs)
# — on a shared MinIO they must not already belong to another app.
MINIO_ENDPOINT=minio:9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=tms
MINIO_ROOT_PASSWORD=change-me

# --- secrets ------------------------------------------------------------
# Session lifetime (hours). 720 = 30 days.
SESSION_TTL_HOURS=720
# pgcrypto key for renter_profiles.nida_number. Generate: openssl rand -hex 32
# Rotating it makes existing values unreadable.
NIDA_ENC_KEY=change-me
# First platform admin, seeded when no platform_admin exists. Blank = skip.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- SMS (Beem) ---------------------------------------------------------
# Blank = dev LogProvider (codes in `make docker-logs`). Set all three for
# real sends; BEEM_SENDER_ID must be approved on the Beem account.
BEEM_API_KEY=
BEEM_SECRET_KEY=
BEEM_SENDER_ID=
NOTIFY_WORKERS=3
SMS_CREDIT_EXEMPT_KINDS=otp

# --- misc ---------------------------------------------------------------
# CIDRs allowed to set X-Forwarded-For. Default in compose covers the docker
# bridge; only change if the edge runs elsewhere.
#TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,127.0.0.0/8
# Images `make docker-deploy` pulls. Built + pushed from a laptop with
# `make docker-publish` (never on the server). Pin a sha tag for reproducible
# rollouts, or override per run: make docker-deploy TAG=<sha>.
API_IMAGE=josephchuchu/tms-api:latest
EDGE_IMAGE=josephchuchu/tms-edge:latest
